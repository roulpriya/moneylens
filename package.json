{
  "name": "moneylens",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "bun run build:report && bun run build:setup",
    "build:report": "bun run scripts/build-report.ts",
    "check:report": "bun run scripts/build-report.ts --check",
    "build:setup": "bun run scripts/build-setup.ts",
    "check:setup": "bun run scripts/build-setup.ts --check",
    "check:plugin": "bun run scripts/check-plugin.ts",
    "test": "bun run scripts/test-python.ts",
    "test:ui": "bun test tests/report.test.ts tests/report-design.test.ts tests/report-contrast.test.ts tests/report-spacing.test.ts"
  },
  "devDependencies": {
    "bun": "1.4.3"
  }
}
